{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Local planner window and user-selected backup files",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-stat"
  ]
}
